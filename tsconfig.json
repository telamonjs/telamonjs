{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "node",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "composite": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/node_modules",
    "**/.next",
    "**/coverage",
    "**/test/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.config.*"
  ]
}
