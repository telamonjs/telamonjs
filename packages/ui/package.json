{
  "name": "@telamonjs/ui",
  "version": "1.0.2",
  "type": "module",
  "description": "Admin framework for Next.js + React: declarative CRUD (CrudConfig + TanStack Query), 36-type field system, rich dialogs, app shell, dashboards and charts",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./charts": {
      "types": "./dist/components/charts/index.d.ts",
      "import": "./dist/components/charts/index.js"
    },
    "./business": {
      "types": "./dist/components/business/index.d.ts",
      "import": "./dist/components/business/index.js"
    },
    "./detail": {
      "types": "./dist/components/detail/index.d.ts",
      "import": "./dist/components/detail/index.js"
    },
    "./styles": "./dist/index.css",
    "./tailwind-preset": "./tailwind-preset.js",
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./cards": {
      "types": "./dist/components/cards/index.d.ts",
      "import": "./dist/components/cards/index.js"
    },
    "./pickers": {
      "types": "./dist/components/pickers/index.d.ts",
      "import": "./dist/components/pickers/index.js"
    },
    "./filters": {
      "types": "./dist/components/filters/index.d.ts",
      "import": "./dist/components/filters/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "dist/index.css"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && cp src/index.css dist/ && node scripts/check-lazy-deps.mjs",
    "dev": "tsup --watch & tsc --watch --emitDeclarationOnly --preserveWatchOutput & (while true; do cp src/index.css dist/ 2>/dev/null; sleep 2; done)",
    "dev:ts": "tsup --watch",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && node scripts/check-i18n-literals.mjs",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "verify": "pnpm lint && pnpm type-check && vitest run && pnpm build",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "admin",
    "dashboard",
    "ui",
    "components",
    "forms",
    "crud",
    "nextjs",
    "tanstack-query",
    "telamonjs",
    "typescript"
  ],
  "author": "Marcos Tullyo (https://github.com/mtullyoc)",
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
