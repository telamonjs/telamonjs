{
  "name": "@telamonjs/queue",
  "version": "1.4.0",
  "description": "BullMQ job engine: config-driven jobs stored in Redis, workers, dead-letter queues, Bull Board dashboard, Prometheus metrics and an HTTP/NestJS backend for queue dashboards",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./job-config": {
      "types": "./dist/job-config/index.d.ts",
      "import": "./dist/job-config/index.js",
      "require": "./dist/job-config/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js",
      "require": "./dist/dashboard/index.js"
    },
    "./monitoring": {
      "types": "./dist/monitoring/index.d.ts",
      "import": "./dist/monitoring/index.js",
      "require": "./dist/monitoring/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "import": "./dist/metrics/index.js",
      "require": "./dist/metrics/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "import": "./dist/scheduler/index.js",
      "require": "./dist/scheduler/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "import": "./dist/nestjs/index.js",
      "require": "./dist/nestjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit && tsc -p tsconfig.typetest.json"
  },
  "keywords": [
    "queue",
    "jobs",
    "bullmq",
    "redis",
    "bull-board",
    "cron",
    "scheduler",
    "worker",
    "background-jobs",
    "task-queue",
    "job-queue",
    "telamonjs",
    "typescript",
    "prometheus",
    "monitoring"
  ],
  "author": "Marcos Tullyo (https://github.com/mtullyoc)",
  "license": "MIT",
  "dependencies": {
    "@bull-board/api": "^6.2.0",
    "@bull-board/express": "^6.2.0",
    "@telamonjs/logger": "workspace:^",
    "@types/express": "^4.17.21 || ^5.0.0",
    "bullmq": "~5.81.4",
    "cron-parser": "^4.9.0",
    "express": "^4.21.2 || ^5.0.0",
    "express-basic-auth": "^1.2.1",
    "ioredis": "~5.11.1",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/testing": "^11.1.19",
    "@telamonjs/permissions": "workspace:^",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.37.0",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.3.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "!dist/**/*.tsbuildinfo",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telamonjs/telamonjs.git",
    "directory": "packages/queue"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://github.com/telamonjs/telamonjs/tree/main/packages/queue#readme",
  "bugs": "https://github.com/telamonjs/telamonjs/issues"
}
