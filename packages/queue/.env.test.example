# Test Environment Variables
# Copy this file to .env.test for local testing

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TEST_DB=15

# Test Behavior
# Set to 'true' to skip tests that require Redis
SKIP_REDIS_TESTS=false

# Set to 'true' to suppress console logs during tests
SUPPRESS_LOGS=true

# Node Environment
NODE_ENV=test
