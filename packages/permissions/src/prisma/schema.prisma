// The RBAC tables of @telamonjs/permissions — the tables the admin kit generates.
// A fragment, not a managed migration: copy these models into your
// schema.prisma, then migrate. Rename tables (@@map) freely; the checker only
// reads the permissions[] claim your login resolves from them.
//
// Your app owns the `User` model. Add the back-relation to it:
//
//   model User {
//     id    String     @id @default(cuid())
//     ...
//     roles UserRole[]
//   }
//
// and keep `UserRole.userId` the same type as `User.id`.

model Role {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique // "superadmin", "admin", "readonly", ...
  description String?
  system      Boolean @default(false) // built-in role: the app must not delete it

  permissions RolePermission[]
  users       UserRole[]
}

// The catalog. Defined in code and reconciled with diffPermissionCatalog().
model Permission {
  id          String  @id @default(cuid())
  code        String  @unique // "module.action", e.g. "users.read"
  module      String // "users"
  // "read" | "write" | "execute" | "approve": the suffix of `code`.
  // A String, not an enum, so a new action needs no migration.
  action      String
  category    String? // groups the permission matrix, e.g. "Records"
  description String?

  roles RolePermission[]

  @@index([module, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}
