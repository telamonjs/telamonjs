# Database
DATABASE_URL="{{databaseUrl}}"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the app (base for auth redirects): set the real one in production.
# Host trust for self-hosting is `trustHost: true` in src/auth.ts, not an env var.
NEXTAUTH_URL="http://localhost:{{appPort}}"

# App Config
NEXT_PUBLIC_APP_NAME="{{appName}}"
NEXT_PUBLIC_APP_URL="http://localhost:{{appPort}}"
