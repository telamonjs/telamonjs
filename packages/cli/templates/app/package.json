{
  "name": "{{projectName}}",
  "version": "1.0.0",
  "description": "Admin application built with TelamonJS framework",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --turbopack -p {{appPort}}",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:telamonjs": "telamonjs lint src/app/admin",
    "type-check": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@hookform/resolvers": "4.1.3",
    "@telamonjs/auth": "^1.2.0",
    "@telamonjs/ui": "{{uiVersion}}",
    "@prisma/client": "6.2.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.545.0",
    "next": "^15.5.29",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.14.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.78.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "2.5.5",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "1.0.7",
    "zod": "^3.25.76",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@telamonjs/cli": "{{cliVersion}}",
    "@types/bcryptjs": "2.4.2",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.0",
    "autoprefixer": "10.7.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.7",
    "postcss": "8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=7.0.0"
  }
}
