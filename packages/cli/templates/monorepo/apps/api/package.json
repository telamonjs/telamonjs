{
  "name": "{{scope}}/api",
  "version": "1.0.0",
  "description": "{{appName}} — NestJS API (/v1)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/apps/api/src/main.js",
    "dev": "nest start --watch",
    "type-check": "tsc --noEmit",
    "test": "jest --config jest.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@telamonjs/auth": "^1.4.0",
    "@telamonjs/permissions": "^1.3.0",
    "@telamonjs/data": "^1.2.0",
    "{{scope}}/shared": "workspace:*",
    "@prisma/client": "6.2.0",
    "bcryptjs": "2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "superjson": "^2.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcryptjs": "2.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "22.18.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
