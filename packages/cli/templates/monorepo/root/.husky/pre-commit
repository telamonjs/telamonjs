#!/bin/sh
# Commits never carry the link to the local telamonjs checkout; post-commit relinks.
# `telamonjs` is the root devDependency @telamonjs/cli (husky puts node_modules/.bin on the PATH).
if grep -Eq '"@telamonjs/ui": "(file|link):' apps/web/package.json 2>/dev/null; then
  telamonjs unlink || exit 1
  # A failed lockfile update must abort the commit, not commit a stale lockfile.
  pnpm install --lockfile-only --silent || exit 1
  git add package.json apps/web/package.json pnpm-lock.yaml || exit 1
fi
