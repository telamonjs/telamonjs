#!/bin/sh
# Relink @telamonjs/ui if it was linked before the commit: pre-commit unlinked
# package.json but left node_modules on the injected copy of the local checkout.
# With pnpm every installed package is a symlink, so check where it resolves to:
# an injected file: dependency lives in node_modules/.pnpm/@telamonjs+ui@file+...,
# a registry install in node_modules/.pnpm/@telamonjs+ui@<version>.
installed=$(cd -P apps/web/node_modules/@telamonjs/ui 2>/dev/null && pwd -P)
case "$installed" in
  */.pnpm/@telamonjs+ui@file+*)
    grep -Eq '"@telamonjs/ui": "(file|link):' apps/web/package.json || telamonjs link
    ;;
esac
