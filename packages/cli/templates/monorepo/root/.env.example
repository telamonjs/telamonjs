# Database (consumed by packages/shared, apps/api and apps/jobs)
DATABASE_URL="{{databaseUrl}}"

# NextAuth (session lives in apps/web; apps/api decodes the same cookie)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the app (base for auth redirects): set the real one in production.
# Host trust for self-hosting is `trustHost: true` in apps/web/src/auth.ts, not an env var.
NEXTAUTH_URL="http://localhost:{{appPort}}"

# Redis (BullMQ — apps/jobs)
REDIS_HOST=localhost
REDIS_PORT={{redisPort}}

# API (apps/api, prefix /v1)
API_PORT={{apiPort}}

# App
NEXT_PUBLIC_APP_NAME="{{appName}}"
NEXT_PUBLIC_APP_URL="http://localhost:{{appPort}}"
